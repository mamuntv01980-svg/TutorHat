rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mamuntv01980@gmail.com' ||
        request.auth.token.email == 'admin@tutorhat.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection: managed by bootstrapped admin
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }

    // 1. Guardian Requests Collection
    // Guardians can submit request from any phone/device; Admin has full view and deletion management
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // 2. Tutors Collection (Profiles & CVs)
    // Tutors can register and edit CV; Admin verifies and manages; public can browse
    match /tutors/{tutorId} {
      allow read, write: if true;
    }

    // 3. Tuition Jobs Collection (Job Circulars)
    // Public can view live tuition jobs; Admin publishes, updates, and deletes
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // 4. Job Applications Collection
    // Tutors can apply; Admin & Job Guardians can view, update and delete
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // 5. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 6. Settings & Demo Collections
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /demos/{demoId} {
      allow read, write: if true;
    }

    match /confirmations/{confId} {
      allow read, write: if true;
    }

    match /attendance/{attId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /certificates/{certId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /notices/{noticeId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /referrals/{referralId} {
      allow read, write: if true;
    }

    match /progress_reports/{reportId} {
      allow read, write: if true;
    }

    match /chat_messages/{msgId} {
      allow read, write: if true;
    }

    match /chat_conversations/{convId} {
      allow read, write: if true;
    }
  }
}
